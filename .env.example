ARK_API_KEY= #7a
MODEL= #deepseek-v4-flash-ga-260731
GRADE_MODEL= #doubao-seed-2-0-lite-260215
FAST_MODEL= #doubao-seed-1-6-flash-250828
BASE_URL= #https://ark.cn-beijing.volces.com/api/v3
ANSWER_TIMEOUT_SECONDS=60
ANSWER_MAX_RETRIES=2

# 本地密集向量（langchain_huggingface / sentence-transformers）
EMBEDDING_MODEL= #BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=true
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_BATCH_TOKENS=8192
PAGE_EMBEDDING_BATCH_SIZE=16
PAGE_EMBEDDING_MAX_CHARS=3000
PAGE_RETRIEVAL_MAX_CHARS=3000
DENSE_EMBEDDING_DIM= #1024

# ===== Rerank (可选，不配则自动降级) =====
RERANK_MODEL= #jina-reranker-v3
RERANK_BINDING_HOST= #https://api.jina.ai/v1/rerank
RERANK_API_KEY= #jina_
RERANK_TIMEOUT_SECONDS=5
RERANK_REMOTE_CANDIDATE_K=16
RERANK_REMOTE_MAX_CHARS=1600
RERANK_REMOTE_MIN_INTERVAL_SECONDS=4
LOCAL_RERANK_ENABLED=false
LOCAL_RERANK_MODEL_PATH=models/bge-reranker-v2-m3
LOCAL_RERANK_DEVICE=auto
LOCAL_RERANK_BATCH_SIZE=8
LOCAL_RERANK_MAX_LENGTH=384
LOCAL_RERANK_CANDIDATE_K=5

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_SEARCH_EF=128
MILVUS_SPARSE_MODE=milvus_bm25
RAG_RETRIEVAL_MODE=baseline
RAG_PROFILE=finance
RAG_EXECUTION_MODE=auto
RAG_AGENT_MAX_ROUNDS=3
RAG_AGENT_MAX_TOOL_CALLS=5
ANSWER_TEMPERATURE=0.1
REDIS_KEY_PREFIX=evidencerag
RAG_QUERY_PLANNER_ENABLED=false
RAG_FIELD_AWARE_ENABLED=true
RAG_PAGE_NEIGHBOR_WINDOW=2
RAG_CONTEXT_PAGE_WINDOW=2
FINANCE_RAG_W_STATEMENT=0.18
FINANCE_RAG_W_REQUIRED_FIELDS=0.25
FINANCE_RAG_W_REQUIRED_PERIODS=0.20
FINANCE_RAG_W_SELECTION_SCOPE=0.30
RAG_SUPPLEMENTAL_SEARCH_ENABLED=true
RAG_SUPPLEMENTAL_CANDIDATE_K=12
RAG_ANCHOR_GUARD_ENABLED=false
RAG_COVER_FILTER_ENABLED=false
RAG_PAGE_FIRST_ENABLED=true
RAG_PAGE_NEIGHBOR_WINDOW=0
AUTO_MERGE_ENABLED=false
RAG_EVIDENCE_GROUPING_ENABLED=false

# ===== FinanceBench / RAG 检索调优 =====
FINANCE_RAG_CANDIDATE_K=40
FINANCE_RAG_FINAL_TOP_K=5
FINANCE_RAG_ENABLE_STEP_BACK=false
FINANCE_RAG_ENABLE_PAGE_MERGE=false
FINANCE_RAG_ADJACENT_PAGE_WINDOW=1
FINANCE_RAG_ADJACENT_CHUNK_WINDOW=1
FINANCE_RAG_TWO_STAGE_RETRIEVAL=true
FINANCE_RAG_DOC_STAGE_TOP_N=5
FINANCE_RAG_PAGE_STAGE_TOP_N=10
FINANCE_RAG_MAX_EVIDENCE_PACK_USED=5
FINANCE_RAG_MIN_EVIDENCE_PACK_USED=3
FINANCE_RAG_MAX_PAGE_TEXT_CHARS=2500
FINANCE_RAG_MAX_TABLE_TEXT_CHARS=2500
FINANCE_RAG_W_DENSE=0.35
FINANCE_RAG_W_KEYWORD=0.20
FINANCE_RAG_W_METRIC=0.15
FINANCE_RAG_W_NUMBER=0.10
FINANCE_RAG_W_COMPANY=0.15
FINANCE_RAG_W_YEAR=0.10
FINANCE_RAG_W_DOC_TYPE=0.05
FINANCE_RAG_COVER_TOC_PENALTY=0.40

# Table-Aware RAG feature flags
# First-stage default: disabled, no behavior change.
TABLE_AWARE_INGESTION=false
TABLE_AWARE_RETRIEVAL=off
TABLE_EVIDENCE_TOP_K=20
TABLE_EVIDENCE_FINAL_MAX=4
TABLE_FULL_FETCH_ENABLED=false
ENABLE_FINANCE_FORMULA_EXPANSION=false
